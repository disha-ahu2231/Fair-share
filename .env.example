# ─── FairShare Server Environment ────────────────────────────────────────────
# Copy this to .env and fill in your values before running the server.

# MongoDB connection string
# Local:   mongodb://localhost:27017/fairshare
# Atlas:   mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/fairshare
MONGO_URI=mongodb://localhost:27017/fairshare

# JWT secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8000
